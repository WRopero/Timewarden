schema_version: 1
project_id: __PROJECT_ID__
language: __LANG__                # es | en: language of the memory documents, briefing, and templates
stale_ignore: [CLAUDE.md, AGENTS.md]   # sources that don't mark a document as stale on their own
memory_dataset: __PROJECT_ID__-knowledge
session_dataset: __PROJECT_ID__-sessions
sources:
  - docs/agent-memory/**/*.md
  - openspec/specs/**/*.md          # current OpenSpec specs (if the repo uses them)
  - openspec/changes/**/*.md        # active and archived proposals
exclude:
  - '**/.env*'
  - '**/credentials/**'
  - '**/*.LOCAL.md'
  - 'docs/agent-memory/handoffs/_local/**'
policy:
  cross_project_recall: false
  capture_raw_sessions: true      # true = session capture on with caps (see spec 20.1); false = off
  max_recall_results: 5
  context_token_budget: 1500
